# =============================================================================
# Contoh Environment Variables Mini PC Docker Compose
# =============================================================================
# Salin file ini menjadi `.env` lalu ganti seluruh nilai placeholder sebelum
# menjalankan `docker compose up -d`. Jangan commit `.env` berisi password asli!

# Zona waktu Mini PC (WIB = Asia/Jakarta, WITA = Asia/Makassar, WIT = Asia/Jayapura)
TZ=Asia/Jakarta

# Subdomain DuckDNS atau domain pribadi yang mengarah ke IP Publik Anda
HA_DOMAIN=plts-shoto-anda.duckdns.org

# Email untuk notifikasi masa berlaku sertifikat SSL Let's Encrypt (Caddy)
ACME_EMAIL=admin@example.com

# IP LAN Mini PC Anda (untuk catatan/referensi serta opsi akses LAN port 8123)
MINI_PC_LAN_IP=192.168.1.50

# Interface bind untuk Home Assistant UI port 8123:
# - `127.0.0.1`   -> hanya bisa diakses via reverse proxy Caddy HTTPS
# - `192.168.1.50` -> bisa diakses langsung dari LAN (`http://192.168.1.50:8123`)
HA_BIND_IP=127.0.0.1

# Kredensial contoh untuk referensi pembuatan akun Mosquitto (`mosquitto_passwd`)
MQTT_USERNAME=shoto_bridge
MQTT_PASSWORD=GANTI_DENGAN_PASSWORD_MQTT_KUAT
